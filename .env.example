# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env.

# --- n8n core ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=production
TZ=Asia/Jakarta
GENERIC_TIMEZONE=Asia/Jakarta

# --- URL publik (ngrok / domain / reverse proxy) ---
# Contoh: https://nama-domain-anda.ngrok-free.app
WEBHOOK_URL=https://your-subdomain.ngrok-free.app
N8N_EDITOR_BASE_URL=https://your-subdomain.ngrok-free.app

# --- Kunci enkripsi kredensial n8n ---
# Buat dengan: openssl rand -base64 32
# PENTING: kunci ini harus sama dengan isi /home/node/.n8n/config
# agar kredensial yang sudah tersimpan bisa dibaca.
N8N_ENCRYPTION_KEY=ganti-dengan-32-byte-base64-acak

# --- Fitur ---
N8N_COMMUNITY_PACKAGES_ALLOW=true
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# --- Basic auth (opsional) ---
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
